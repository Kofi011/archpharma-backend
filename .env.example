# ArchPharma Wholesale ERP - Backend Environment Configuration

# Server Port
PORT=3000

# Cloud PostgreSQL Connection URL (Used on Railway / Supabase / Render)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
DATABASE_URL=

# Local PostgreSQL Configuration (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=archpharma
DB_SSL=false

# Authentication Secret
JWT_SECRET=archpharma_super_secret_jwt_key_2026
